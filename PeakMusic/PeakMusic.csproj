<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PeakMusic</AssemblyName>
    <RootNamespace>PeakMusic</RootNamespace>
    <Version>0.1.0</Version>

    <!--
      注意：这份引用清单是按 Unity 6000.3.15（Unity 6）改过的。
      原流程文档里的 <Reference Include="UnityEngine"> 在这个游戏里不存在——
      Unity 6 把 UnityEngine 拆成了若干 Module，少了 UnityEngine.dll 这个总装程序集。
      所以这里一律按 Module 引，缺哪个报错就补哪个。
    -->
    <GameDir>D:\Steam\steamapps\common\PEAK</GameDir>
    <ManagedDir>$(GameDir)\PEAK_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 协议层（网易接口 / JSON / 歌词），纯 C#，不碰 Unity -->
    <ProjectReference Include="..\PeakMusic.Core\PeakMusic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 5 本体，绝不复制到输出目录 -->
    <!-- 推 Folia Stage API 用到 HttpClient（net472 必须显式引） -->
    <Reference Include="System.Net.Http" />

    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 游戏程序集 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity 6 模块：只引真正用到的，编不过时按报错补 -->
    <!-- UnityEngine.dll 在这份游戏里是存在的（类型转发门面）。BepInEx 5 的 BaseUnityPlugin
         继承链上引用的就是 "UnityEngine, Version=0.0.0.0"，少了它一定报 CS0012。 -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity 6 的 UnityEngine.AudioModule 是按 netstandard 2.1 编的，
         net472 默认带的是 2.0 facade，直接用 AudioClip.Create 会报 CS1705。
         改成指向游戏自带的 netstandard.dll（2.1）即可，运行时本来用的也是它。 -->
    <Reference Include="netstandard">
      <HintPath>$(ManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- TextMeshPro（世界空间 SDF 歌词）。TMP 本身依赖 TextCore 的字体引擎和文本引擎，
         少了会报 FontEngine / TextInfo 找不到。 -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 世界歌词射线避墙用到 Physics / LayerMask / QueryTriggerInteraction -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 热键走 Input System（游戏自带），旧版 Input 作为兜底 -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 「一起听」联机同步：Photon PUN 全家桶（游戏自带，仅引用不复制） -->
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 无损解码：FlacBox（纯 C#，NuGet flacbox 1.0.1 / lib/net35）。
         必须 Private=true —— 游戏目录里没有这个库，得随插件一起发。 -->
    <Reference Include="FlacBox">
      <HintPath>lib\FlacBox.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Photon3Unity3D">
      <HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 编译完自动部署到插件目录（只部署面板本身）。
       注意：**故意不部署 PeakMusic.Core.dll**。本仓库里的 PeakMusic.Core 源码是旧版，
       编译出来会缺 media_mid 等字段（会员曲取流会退化），一旦被这段自动部署拷过去，
       就会把正确的 Core 覆盖掉，而且很难发现。Core 请用发布包里的那一份，别在这里覆盖。 -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true' and Exists('$(GameDir)\BepInEx\plugins')">
    <ItemGroup>
      <DeployFiles Include="$(TargetPath)" />
      <DeployFiles Include="lib\FlacBox.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\PeakMusic\" />
    <Message Text="已部署面板 → $(GameDir)\BepInEx\plugins\PeakMusic\（Core 不自动覆盖）" Importance="high" />
  </Target>

</Project>
